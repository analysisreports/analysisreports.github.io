    {
      "id": "MODEL_25.1",
      "label": "Dynamic Polarity & Regime Engine",
      "category": "MODEL",
      "attributes": {
        "function": "dynamic_polarity_engine",
        "formula": "P_net = min(1.0, max(-1.0, P_baseline + dynamic_delta))",
        "regimes": [
          "ALLIANCE",
          "STRATEGIC_ALIGNMENT",
          "TACTICAL_COOPERATION",
          "NEUTRAL",
          "STRATEGIC_FRICTION",
          "PROXY_WAR",
