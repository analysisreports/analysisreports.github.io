    {
      "id": "MODEL_25.1",
      "label": "Dynamic Polarity & Regime Engine",
      "category": "MODEL",
      "attributes": {
        "function": "dynamic_polarity_engine",
        "formula": "P_net = min(1.0, max(-1.0, P_baseline + dynamic_delta))",
        "regimes": [
          "ALLIANCE",
          "STRATEGIC_ALIGNMENT",
          "TACTICAL_COOPERATION",
          "NEUTRAL",
          "STRATEGIC_FRICTION",
          "PROXY_WAR",
          "KINETIC_WAR"
        ]
      }
    },
    {
      "id": "MODEL_25.2",
      "label": "Sticky vs. Flexible CPI Spread Engine",
      "category": "MODEL",
      "attributes": {
        "function": "sticky_flexible_cpi_spread",
        "formula": "Sticky_Impulse = Sticky_CPI_YoY - Flexible_CPI_YoY",
        "status_enums": [
          "STRUCTURAL_INFLATION_TRAP",
          "TRANSITORY_INFLATION_SURGE",
          "BALANCED_DISINFLATION_PATH"
        ]
      }
    },
    {
      "id": "MODEL_25.3",
      "label": "NY Fed GSCPI Logistics Engine",
      "category": "MODEL",
      "attributes": {
        "function": "global_supply_chain_pressure",
        "formula": "GSCPI_ZScore = GSCPI_Value",
        "status_enums": [
          "SUPPLY_CHAIN_SHOCK",
          "LOGISTICS_DEFLATION_SLACK",
          "NORMALIZED_GLOBAL_TRADE"
        ]
      }
    },
    {
      "id": "MODEL_25.4",
      "label": "MOVE / VIX Disconnect Ratio Engine",
      "category": "MODEL",
      "attributes": {
        "function": "move_vix_disconnect_ratio",
        "formula": "Vol_Disconnect_Ratio = MOVE_Index / VIX_Index",
        "status_enums": [
          "RATE_RISK_MISPRICING_ALARM",
          "EQUITY_PANIC_DOMINANCE",
          "COHERENT_MARKET_VOLATILITY"
        ]
      }
    },
    {
      "id": "MODEL_25.5",
      "label": "Repo Liquidity Friction Spread Engine",
      "category": "MODEL",
      "attributes": {
        "function": "repo_liquidity_friction_spread",
        "formula": "Repo_Friction_bps = (SOFR - EFFR) * 100",
        "status_enums": [
          "REPO_MARKET_LIQUIDITY_CRUNCH",
          "SYSTEMIC_CASH_DRAIN_WARNING",
          "COLLATERAL_SCARCITY_GLUT",
          "HEALTHY_MONETARY_TRANSMISSION"
        ]
      }
    },
    {
      "id": "MODEL_25.6",
      "label": "Gold / Real Yield Debasement Gauge",
      "category": "MODEL",
      "attributes": {
        "function": "gold_real_yield_debasement_gauge",
        "formula": "f(Real_Yield_10Y, Gold_YoY_Pct)",
        "status_enums": [
          "DEBALANCING_DEDOLLARIZATION_PANIC",
          "ACCOMMODATIVE_GOLD_BULL",
          "TRADITIONAL_REAL_RATE_DOMINANCE"
        ]
      }
    },
    {
      "id": "MODEL_25.7",
      "label": "OVX / VIX Geopolitical Energy Shock Engine",
      "category": "MODEL",
      "attributes": {
        "function": "ovx_vix_risk_premium",
        "formula": "Vol_Ratio = OVX_Index / VIX_Index",
        "status_enums": [
          "ENERGY_SUPPLY_SHOCK_ALARM",
          "EQUITY_PANIC_OVER_ENERGY",
          "BALANCED_ENERGY_VOLATILITY"
        ]
      }
    },
    {
      "id": "MODEL_25.8",
      "label": "NatGas / Crude Oil BTU Disconnect Engine",
      "category": "MODEL",
      "attributes": {
        "function": "natgas_crude_btu_disconnect",
        "formula": "BTU_Disconnect_Ratio = WTI_Price / NatGas_Price",
        "status_enums": [
          "NATGAS_CRISIS_BLACKOUT_RISK",
          "NATGAS_GLUT_ENERGY_CHEAP",
          "ENERGY_PARITY_EQUILIBRIUM"
        ]
      }
    },
    {
      "id": "MODEL_25.9",
      "label": "Gasoline / Crude Crack Spread Impulse Engine",
      "category": "MODEL",
      "attributes": {
        "function": "gasoline_crude_crack_spread",
        "formula": "Crack_Spread_USD = (Gasoline_Gallon_Price * 42) - WTI_Barrel_Price",
        "status_enums": [
          "REFINERY_BOTTLENECK_CRUNCH",
          "REFINING_MARGIN_COLLAPSE",
          "NORMAL_REFINING_MARGIN"
        ]
      }
    },
    {
      "id": "MODEL_28.3",
      "label": "Chokepoint Severity Multiplier Engine",
      "category": "MODEL",
      "attributes": {
        "function": "chokepoint_severity_multiplier",
        "formula": "Disruption_Weight = SEVERITY_WEIGHT_MAP[severity_enum]",
        "weight_map": {
          "CATASTROPHIC": 1.0,
          "HIGH": 0.7,
          "MODERATE-HIGH": 0.45,
          "MODERATE": 0.2
        }
      }
    },
    {
      "id": "MODEL_28.4",
      "label": "Chokepoint Macro Transmission Bridge",
      "category": "MODEL",
      "attributes": {
        "function": "chokepoint_transmission_bridge",
        "formula": "Spillover_Score = min(100.0, (Disruption_Weight * 70.0) + (Friction_Factor * 30.0))",
        "status_enums": [
          "CRITICAL_SYSTEMIC_SHOCK",
          "HIGH_SPILLOVER",
          "MODERATE_FRICTION",
          "LOCALIZED_IMPACT"
        ]
