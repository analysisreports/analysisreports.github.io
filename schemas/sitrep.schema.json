{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://analysisreports.github.io/schemas/sitrep.schema.json",
  "title": "Autonomous Macro & Geopolitical Situation Report (SITREP) Schema",
  "description": "Formal JSON Schema Draft 2020-12 data contract for consolidated real-time macro telemetry, chokepoint AIS, and media reality check contagion rules.",
  "type": "object",
  "required": [
    "metadata",
    "top_systemic_flashes",
    "energy_matrix",
    "semiconductors_tech",
    "metals_commodities",
    "maritime_chokepoints",
    "macro_liquidity",
    "systemic_contagion_rules"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "required": [
        "title",
        "domain",
        "version",
        "author",
        "license",
        "endpoint",
        "documentation",
        "last_updated",
        "sync_status",
        "data_completeness_pct",
        "source_authority",
        "methodology_reference",
        "root_index"
      ],
      "properties": {
        "title": { "type": "string" },
        "domain": { "type": "string" },
        "version": { "type": "string" },
        "author": { "type": "string" },
        "license": { "type": "string" },
        "endpoint": { "type": "string", "format": "uri" },
        "documentation": { "type": "string", "format": "uri" },
        "last_updated": { "type": "string", "format": "date-time" },
        "sync_status": { "type": "string", "enum": ["SUCCESS", "FAILED", "PARTIAL"] },
        "data_completeness_pct": { "type": "number" },
        "source_authority": { "type": "string" },
        "methodology_reference": { "type": "string", "format": "uri" },
        "root_index": { "type": "string", "format": "uri" }
      }
    },
    "top_systemic_flashes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "entity_id", "event"],
        "properties": {
          "source": { "type": "string" },
          "entity_id": { "type": "string" },
          "event": { "type": "string" }
        }
      }
    },
    "energy_matrix": { "type": "object" },
    "semiconductors_tech": { "type": "object" },
    "metals_commodities": { "type": "object" },
    "maritime_chokepoints": { "type": "object" },
    "macro_liquidity": { "type": "object" },
    "systemic_contagion_rules": {
      "type": "array",
      "description": "Deterministic rules for validating mainstream news narratives against physical ground truth telemetry.",
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "domain",
          "telemetry_signal",
          "media_claim_bias",
          "ground_truth_reality"
        ],
        "properties": {
          "rule_id": { "type": "string" },
          "domain": { "type": "string" },
          "telemetry_signal": { "type": "string" },
          "media_claim_bias": { "type": "string" },
          "ground_truth_reality": { "type": "string" }
        }
      }
    }
  }
}
